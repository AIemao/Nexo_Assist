// Schema do ticket-service (ADR-008; DM v2.9 §3.2). Enums na ordem dos arrays do domínio.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TicketType {
  INC
  REQ
}

enum TicketCategory {
  ACCESS
  NETWORK_VPN
  HARDWARE
  SOFTWARE
  EMAIL
  OTHER
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  WAITING_ANALYST
  APPROVED
  RESOLVED
}

enum WorkImpact {
  BLOCKED
  DEGRADED_WITH_WORKAROUND
  NONE
}

enum AffectedScope {
  SELF
  TEAM
  COMPANY
  UNKNOWN
}

enum CommitmentRisk {
  YES
  NO
  UNKNOWN
  NOT_ASKED
}

enum TicketEventType {
  CREATED
  UPDATED
  REOPENED
  TRANSFERRED
  ASSIGNED
  STATUS_CHANGED
}

enum ActorType {
  EMPLOYEE
  ANALYST
  SYSTEM
}

enum TicketOperationType {
  CREATE
  UPDATE
  REOPEN
  TRANSFER
}

enum EmployeeRole {
  EMPLOYEE
  ANALYST
}

// DM §3.1. E-mail gravado já normalizado (trim + minúsculas), com @unique (ADR-008,
// atualização de 2026-11-21). Funcionários não são excluídos: FKs com Restrict.
model Employee {
  id               String        @id
  name             String
  email            String        @unique
  department       String
  role             EmployeeRole
  requestedTickets Ticket[]      @relation("TicketRequester")
  assignedTickets  Ticket[]      @relation("TicketAssignee")
  ticketEvents     TicketEvent[]
}

// Sem defaults: id, version, datas e status são fornecidos pelo ticket-service (DM §3.2).
// requesterId (obrigatória) e assignedTo (opcional) referenciam Employee (ADR-008,
// atualização de 2026-11-21).
model Ticket {
  id                   String              @id
  version              Int
  type                 TicketType
  title                String
  description          String
  category             TicketCategory
  priority             Priority
  status               TicketStatus
  requesterId          String
  requester            Employee            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workImpact           WorkImpact
  affectedScope        AffectedScope
  commitmentRisk       CommitmentRisk
  assignedTo           String?
  assignee             Employee?           @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt            DateTime
  updatedAt            DateTime
  resolvedAt           DateTime?
  firstResponseDueAt   DateTime
  nextUpdateDueAt      DateTime?
  serviceDeskUpdatedAt DateTime?
  events               TicketEvent[]
  idempotencyRecords   IdempotencyRecord[]
}

// DM §3.9. actor em duas colunas; changes é um Json cujo valor é um array.
// Chamados não são excluídos: FK com Restrict. actorEmployeeId (opcional) referencia
// Employee (ADR-008, atualização de 2026-11-21).
model TicketEvent {
  id              String          @id
  ticketId        String
  ticket          Ticket          @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type            TicketEventType
  actorType       ActorType
  actorEmployeeId String?
  actorEmployee   Employee?       @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  summary         String
  changes         Json
  occurredAt      DateTime
}

// DM §3.16. Registro técnico; key = OperationExecution.id.
model IdempotencyRecord {
  key           String              @id
  operationType TicketOperationType
  ticketId      String
  ticket        Ticket              @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  result        Json
  createdAt     DateTime
}

// DM §3.2. Um contador por tipo; linha criada por upsert no primeiro uso.
model TicketCounter {
  type       TicketType @id
  lastNumber Int
}
