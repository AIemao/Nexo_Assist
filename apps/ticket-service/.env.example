# Variáveis do ticket-service (apps/ticket-service). Só exemplos; nenhum valor real.

# Banco SQLite do ticket-service (ADR-008), separado do banco do web.
DATABASE_URL="file:./prisma/dev.db"

# Interface e porta do servidor HTTP. Padrões: 127.0.0.1 e 3001 (README §5).
HOST="127.0.0.1"
PORT="3001"

# Falha simulada (cenários §2.2). Desligada quando ausente.
# SIMULATED_FAULT: F-DROP-BEFORE | F-DROP-AFTER | F-SLOW
# SIMULATED_FAULT_DELAY_MS: inteiro de 1 a 2147483647, só algarismos; obrigatória com F-SLOW e só com ela.
# SIMULATED_FAULT="F-SLOW"
# SIMULATED_FAULT_DELAY_MS="5000"
