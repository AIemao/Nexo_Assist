# Variáveis do web (apps/web). Só exemplos; nenhum valor real.

# Banco SQLite do web, separado do banco do ticket-service (ADR-011).
WEB_DATABASE_URL="file:./prisma/web-dev.db"

# Endereço do ticket-service, usado só pelo BFF (README §8; README §12 #26).
TICKET_SERVICE_URL="http://127.0.0.1:3001"

# Endpoint compatível com OpenAI do Ollama local (ADR-009). Padrão: http://localhost:11434/v1.
OLLAMA_BASE_URL="http://localhost:11434/v1"
